
pipeline {
    agent any

    environment {
        REGION           = 'us-east-1'
        ACCOUNT_ID       = '629624132692'
        ECR_REG_NAME     = 'simple_apps'
        ECR_URI          = "${ACCOUNT_ID}.dkr.ecr.${REGION}.amazonaws.com"

        AWS_ACCESS_KEY_ID     = credentials('ACCESS_KEY')
        AWS_SECRET_ACCESS_KEY = credentials('SECRET_ACCESS_KEY')

        BRANCH          = 'main'
        GITHUB_URL      = 'https://github.com/avinashganta5/Jenkins_pipeline_practice.git'
        IMAGE_NAME      = 'simple_apps'
        CONTAINER_NAME  = 'nodejs-app'
        HOST_PORT       = '3000'
        APP_PORT        = '3000'
    }

    stages {
        stage('Clean Ws') {
            steps {
                cleanWs()
            }
        }

        stage('Code Checkout') {
            steps {
                git branch: "${BRANCH}",
                    url: "${GITHUB_URL}"
            }
        }

        stage('Dependencies') {
            steps {
                dir('Simple_Nodejs') {
                    sh 'npm install'
                }
            }
        }

        stage('Test') {
            steps {
                dir('Simple_Nodejs') {
                    sh 'npm test --if-present'
                }
            }
        }

        stage('AWS ECR Login') {
            steps {
                sh '''
                    aws ecr get-login-password --region "$REGION" |
                    docker login --username AWS --password-stdin "$ECR_URI"
                '''
            }
        }

        stage('Image Build') {
            steps {
                dir('Simple_Nodejs') {
                    sh '''
                        docker build \
                            -t "$IMAGE_NAME:$BUILD_ID" \
                            .
                    '''
                }
            }
        }

        stage('Image Tag') {
            steps {
                sh '''
                    docker tag \
                        "$IMAGE_NAME:$BUILD_ID" \
                        "$ECR_URI/$ECR_REG_NAME:$BUILD_ID"
                '''
            }
        }

        stage('Push Image to ECR') {
            steps {
                sh '''
                    docker push "$ECR_URI/$ECR_REG_NAME:$BUILD_ID"
                '''
            }
        }

        stage('Removing old Containers') {
            steps {
                sh '''
                    docker rm -f "$CONTAINER_NAME" 2>/dev/null || true
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker pull "$ECR_URI/$ECR_REG_NAME:$BUILD_ID"

                    docker run -d \
                        --name "$CONTAINER_NAME" \
                        --restart unless-stopped \
                        -p "$HOST_PORT:$APP_PORT" \
                        "$ECR_URI/$ECR_REG_NAME:$BUILD_ID"
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
            echo "Application URL: http://localhost:${HOST_PORT}"
        }

        failure {
            echo 'Pipeline failed. Check the Jenkins console output.'
        }
    }
}
